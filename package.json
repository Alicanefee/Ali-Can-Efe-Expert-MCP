{
  "name": "ali-efe-expert-mcp",
  "version": "0.4.0",
  "description": "MCP server that publishes a structured, self-published professional profile (background, consulting services, projects, research results) to AI assistants via the Model Context Protocol",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ali-efe-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json",
    "deploy:cloudflare": "wrangler deploy",
    "deploy:dev": "wrangler dev",
    "smoke:remote": "node scripts/smoke-remote.mjs",
    "test": "node /home/z/my-project/scripts/test-mcp-client-v2.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "professional-profile",
    "healthcare-ai",
    "medical-imaging",
    "regulatory-ai",
    "cloudflare-workers"
  ],
  "author": "Ali Can Efe",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "wrangler": "^4.143.0"
  }
}
